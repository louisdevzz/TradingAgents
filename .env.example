# SSI iBoard – Vietnam Stock Market (required when market_mode = "vietnam")
# How to get these cookies:
#   1. Open https://iboard.ssi.com.vn in Chrome
#   2. Log in with your SSI account
#   3. Open DevTools → Application → Cookies → https://iboard.ssi.com.vn
#   4. Copy the values below
SSI_CF_CLEARANCE=
SSI_ID_TOKEN=
SSI_TOKEN=
